    "version": "0.2.0",
    "configurations": [
        {
            "name": "downloads",
            "type": "debugpy",
            "request": "launch",
            "module": "src.launcher",
            "args": [
                "--program",
                "gitgui",
                "--working-tree",
                "/Users/andrej/Downloads",
                "--git-directory-location",
                "tests-real-sensitive-data/test-downloads-repo",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "this repo",
            "type": "debugpy",
            "request": "launch",
            "module": "src.launcher",
            "args": [
                "--program",
                "gitgui",
                "--working-tree",
                ".",
                "--git-directory-location",
                ".",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "project-selector",
            "type": "debugpy",
            "request": "launch",
            "module": "src.launcher",
            "args": [
                "--program",
                "project-selector",
                "--projects-file",
                "tests-real-sensitive-data/projects.yaml",
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
        },
    ]
}